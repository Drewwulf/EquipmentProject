@model EquipmentProject.Models.ViewModels.SiteSettingViewModel
    @{
        ViewData["Title"] = "Налаштування";
    }
    <form asp-controller="Admin" asp-action="SetSettings" method="post">
    <div class="product-edit-page">

        <!-- Заголовок -->
        <h2 class="product-edit-title">Налаштувати сайт</h2>


        <!-- =========================
         ОСНОВНА ІНФОРМАЦІЯ
    ========================== -->
        <section class="product-section">

            <h3>Загальна інформація</h3>

            <!-- Назва магазину -->
            <div class="product-field">
                <label for="shopName">
                    Назва магазину*
                </label>

                <input type="text"
                       id="shopName"
                       asp-for="ShopName"
                       required />
            </div>

            <!-- Заголовок -->
            <div class="product-field">
                <label for="headerInfo">
                    Заголовок банера (головна сторінка)*
                </label>

                <input type="text"
                       id="headerInfo"
                       asp-for="HeaderInfo"
                       required />
            </div>

            <!-- Підзаголовок -->
            <div class="product-field">
                <label for="subHeaderInfo">
                    Підзаголовок банера
                </label>

                <input type="text"
                       id="subHeaderInfo"
                       asp-for="SubHeaderInfo" />
            </div>

            <!-- Опис -->
            <div class="product-field">

                <label for="shopDesc">
                    Текст *Про компанію*
                </label>

                <textarea id="shopDesc"
                          class="full-description"
                          placeholder="Детальний опис магазину"
                          asp-for="ShopDesc"
                          required></textarea>

            </div>

            <input type="hidden" asp-for="Id" />

        </section>

        <!-- =========================
         ТЕХНІЧНІ ХАРАКТЕРИСТИКИ
    ========================== -->

        <section class="product-section ">

            <div class="section-header">

                <h3>
                    Технічні характеристики
                </h3>

                <button type="button"
                        class="add-button"
                        id="addSpecification">

                    + Додати

                </button>

            </div>


            <div id="specificationsContainer">

                <p class="empty-specifications">
                    Характеристик поки немає. Додайте першу.
                </p>

            </div>

        </section>

        <section class="product-section">
       
                <h3>Соціальна мережа</h3>


                <div class="product-field">
                    <label for="productName">
                        Facebook
                    </label>

                    <input type="text"
                           id="productName"
                   value="@Model.SocialFacebook" asp-for="SocialFacebook" />
                </div>

                <div class="product-field">
                    <label for="productName">
                        Instagram
                    </label>

                    <input type="text"
                           id="productName"
                   value="@Model.SocialInstagram" asp-for="SocialInstagram">
                </div>

                <div class="product-field">
                    <label for="productName">
                        Telegram
                    </label>

                    <input type="text"
                           id="productName"
                       value="@Model.SocialTelegram" asp-for="SocialTelegram" />
                </div>

        </section>



        <div class="product-actions">

            <button type="submit"
                    class="save-button">

                <span>▣</span>
                Зберегти налаштування

            </button>


            <button type="button"
                    class="cancel-button">

                Скасувати

            </button>




        </div>

    </div>
    </form>


    <script>
        const contacts = @Html.Raw(Json.Serialize(Model.Contacts));

        let siteind = contacts.length;

        const addSpecificationButton =
            document.getElementById("addSpecification");

        const specificationsContainer =
            document.getElementById("specificationsContainer");


        // Виводимо існуючі контакти
        for (let i = 0; i < contacts.length; i++) {
             
            const contact = contacts[i];

            const specification =
                document.createElement("div");

            specification.className = "specification-row";

            specification.innerHTML = `
                <section class="product-section">

                    <h3>Загальна інформація</h3>

                    <div class="product-field">
                        <label>Адреса</label>

                        <input type="text"
                               name="Contacts[${i}].Address"
                               value="${contact.address ?? ''}" required />
                    </div>

                    <div class="product-field">
                        <label>Номер телефону</label>

                        <input type="text"
                               name="Contacts[${i}].PhoneNumber"
                               value="${contact.phoneNumber ?? ''}" required />
                    </div>

                    <div class="product-field">
                        <label>Email</label>

                        <input type="text"
                               name="Contacts[${i}].Email"
                               value="${contact.email ?? ''}" required />
                    </div>

                    <div class="product-field">
                        <label>Графік роботи</label>

                        <textarea name="Contacts[${i}].Schedule"
                                  class="full-description" required>${contact.schedule ?? ''}</textarea>
                    </div>

                    <button type="button"
                            class="delete-specification">
                        ×
                    </button>

                </section>
            `;

            specificationsContainer.appendChild(specification);
        }


        // Додавання нового контакту
        addSpecificationButton.addEventListener("click", function () {

            const specification =
                document.createElement("div");

            specification.className = "specification-row";

            specification.innerHTML = `
                <section class="product-section">

                    <h3>Загальна інформація</h3>

                    <div class="product-field">
                        <label>Адреса</label>

                        <input type="text"
                               name="Contacts[${siteind}].Address" required/>
                    </div>

                    <div class="product-field">
                        <label>Номер телефону</label>

                        <input type="text"
                               name="Contacts[${siteind}].PhoneNumber" required/>
                    </div>

                    <div class="product-field">
                        <label>Email</label>

                        <input type="text"
                               name="Contacts[${siteind}].Email" required/>
                    </div>

                    <div class="product-field">
                        <label>Графік роботи</label>

                        <textarea name="Contacts[${siteind}].Schedule"
                                  class="full-description" required ></textarea>
                    </div>

                    <button type="button"
                            class="delete-specification">
                        ×
                    </button>

                </section>
            `;

            specificationsContainer.appendChild(specification);

            siteind++;
        });

    </script>