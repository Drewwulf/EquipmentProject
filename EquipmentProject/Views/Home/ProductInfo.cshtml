
@model EquipmentProject.Models.Product

@{
    ViewData["Title"] = Model.ProductName;
}

<div class="product-view-page">

    <!-- =========================
         BREADCRUMBS
    ========================= -->

    <div class="product-view-breadcrumbs">

        <a asp-controller="Home"
           asp-action="Index">
            ⌂ Головна
        </a>

        <span>›</span>

       

        <a asp-controller="Home"
           asp-action="SubcategoryCatalog"
           asp-route-id="@Model.CategoryId">
          @Model.Subcategory.Categories.ProductName
        </a>

        @if (Model.Subcategory != null)
        {
            <span>›</span>
            
            <a asp-controller="Home"
            asp-action="ProductCatalog"
             asp-route-id="@Model.SubcategoryId"> 
                @Model.Subcategory.NameSubcategory
            </a>
        }

        <span>›</span>

        <strong>
            @Model.ProductName
        </strong>

    </div>


    <!-- =========================
         PRODUCT
    ========================= -->

    <div class="product-view-content">

                <!-- ФОТО + ВІДЕО (галерея) -->
        @{
            // всі фото: головне + додані з адмінки
            var slides = new List<string>();
            if (!string.IsNullOrWhiteSpace(Model.ImgPath))
                slides.Add(Model.ImgPath);

            if (Model.Images != null)
                slides.AddRange(Model.Images
                    .Where(i => !string.IsNullOrWhiteSpace(i.ImgPath))
                    .Select(i => i.ImgPath));

                      // Відео: YouTube-посилання або файл із адмінки
            string videoSrc = null;
            string ytId = null;
            bool isYouTube = false;
            var rawVideo = Model.YouTubeVideo?.Trim();

            if (!string.IsNullOrWhiteSpace(rawVideo))
            {
                if (Uri.TryCreate(rawVideo, UriKind.Absolute, out var yt)
                    && (yt.Host.Contains("youtube.com") || yt.Host.Contains("youtu.be")))
                {
                    var vid = System.Web.HttpUtility.ParseQueryString(yt.Query)["v"]
                              ?? yt.Segments.Last().Trim('/');
                    ytId = vid;
                    videoSrc = $"https://www.youtube.com/embed/{vid}";
                    isYouTube = true;
                }
                else
                {
                    // шлях до файлу на сервері
                    videoSrc = rawVideo.StartsWith("~/") ? Url.Content(rawVideo) : rawVideo;
                }
            }

            var total = slides.Count + (videoSrc != null ? 1 : 0);
            var videoFirst = slides.Count == 0;



                        var lightboxItems = slides
                .Select(s => new { type = "img", src = s, thumb = s })
                .ToList();

            var lightboxAll = lightboxItems.Cast<object>().ToList();
            if (videoSrc != null)
            {
                lightboxAll.Add(new
                {
                    type = isYouTube ? "youtube" : "video",
                    src = videoSrc,
                    thumb = isYouTube ? $"https://img.youtube.com/vi/{ytId}/mqdefault.jpg" : ""
                });
            }

            var lightboxJson = System.Text.Json.JsonSerializer.Serialize(lightboxAll);
           
        }

        <div class="product-view-image">

            @if (total == 0)
            {
                <div class="product-view-no-photo">
                    <span>Фото відсутнє</span>
                </div>
            }
            else
            {
                <div id="productGallery" class="carousel slide product-gallery" data-bs-interval="false">

                    <div class="carousel-inner">

                        @for (int i = 0; i < slides.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                               <img src="@slides[i]" alt="@Model.ProductName" class="gallery-zoom" data-index="@i" />
                            </div>
                        }

                                               @if (videoSrc != null)
                        {
                            <div class="carousel-item @(videoFirst ? "active" : "")">

                                @if (isYouTube)
                                {
                                    <iframe data-src="@videoSrc"
                                            src="@(videoFirst ? videoSrc : null)"
                                            title="YouTube video player"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            referrerpolicy="strict-origin-when-cross-origin"
                                            allowfullscreen></iframe>
                                }
                                else
                                {
                                    <video src="@videoSrc"
                                           controls
                                           preload="metadata"
                                           playsinline></video>
                                }

                            </div>
                        }

                    </div>

                    @if (total > 1)
                    {
                        <button class="carousel-control-prev" type="button"
                                data-bs-target="#productGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button"
                                data-bs-target="#productGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>

                        <div class="carousel-indicators">
                            @for (int i = 0; i < total; i++)
                            {
                                <button type="button"
                                        data-bs-target="#productGallery"
                                        data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")"></button>
                            }
                        </div>
                    }
                </div>
            }

        </div>
        <!-- ІНФОРМАЦІЯ -->

        <div class="product-view-info">

            <!-- Артикул -->

            <div class="product-view-articul">

                <span>Артикул:</span>

                @Model.Articul

            </div>


            <!-- Назва -->

            <h1 class="product-view-title">
                @Model.ProductName
            </h1>


            <div class="product-view-separator"></div>


            <!-- Ціна -->

            <div class="product-view-price">
                @Model.Price.ToString("N0") ₴
            </div>

            <div class="product-view-price-note">
                Ціна вказана за умови самовивозу зі складу
            </div>


            <div class="product-view-separator"></div>


            <!-- КНОПКИ -->

            <div class="product-view-buttons">

                <a href="/contacts"
                   class="product-view-button product-view-button-main">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="17"
                         height="17"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                 19.79 19.79 0 0 1-8.63-3.07
                                 19.5 19.5 0 0 1-6-6
                                 19.79 19.79 0 0 1-3.07-8.67
                                 A2 2 0 0 1 4.11 2h3
                                 a2 2 0 0 1 2 1.72
                                 12.84 12.84 0 0 1 .7 2.81
                                 2 2 0 0 1-.45 2.11L8.09 9.91
                                 a16 16 0 0 0 6 6l1.27-1.27
                                 a2 2 0 0 1 2.11-.45
                                 12.84 12.84 0 0 0 2.81.7
                                 A2 2 0 0 1 22 16.92z">
                        </path>

                    </svg>

                    Замовити консультацію

                </a>


                <a href="/contacts"
                   class="product-view-button product-view-button-outline">

                    Залишити запит

                </a>

            </div>

        </div>

    </div>


    <!-- =========================
         DESCRIPTION
    ========================= -->





@if (!string.IsNullOrWhiteSpace(Model.FullDescription) || Model.TechnicalCharacteristics.Any())
{
    <div class="product-view-details">

        <!-- Детальний опис -->
        <div class="product-view-full-description">

            <div class="product-view-section-title">
                Детальний опис
            </div>

            <div class="product-view-description-content">
                @Html.Raw(Model.FullDescription)
            </div>

        </div>

        <!-- Технічні характеристики -->
        <div class="product-view-specifications">

            <div class="product-view-section-title">
                Технічні характеристики
            </div>

            <table class="product-view-spec-table">

                <tbody>

                @foreach (var item in Model.TechnicalCharacteristics)
                {
                    <tr>
                        <td class="product-view-spec-name">
                            @item.ParamentName
                        </td>

                        <td class="product-view-spec-value">
                            @item.ParamentValue
                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>
}
<div id="lightbox" class="lb" hidden>
    <div class="lb-dialog">
        <div class="lb-header">
            <span class="lb-title">@Model.ProductName</span>
            <button type="button" class="lb-close" aria-label="Закрити">&times;</button>
        </div>

        <div class="lb-body">
            <div class="lb-thumbs" id="lbThumbs"></div>

            <div class="lb-stage">
                <button type="button" class="lb-nav lb-prev" aria-label="Назад">&#10094;</button>
                <div class="lb-media" id="lbMedia"></div>
                <button type="button" class="lb-nav lb-next" aria-label="Далі">&#10095;</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var items = @Html.Raw(lightboxJson);
    var lb = document.getElementById('lightbox');
    if (!lb || !items.length) return;

    var media = document.getElementById('lbMedia');
    var thumbs = document.getElementById('lbThumbs');
    var current = 0;

    // мініатюри
    items.forEach(function (it, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'lb-thumb' + (it.type === 'video' ? ' lb-thumb-video-only' : '');
        if (it.thumb) {
            var im = document.createElement('img');
            im.src = it.thumb;
            b.appendChild(im);
        }
        if (it.type !== 'img') {
            var p = document.createElement('span');
            p.className = 'lb-thumb-play';
            p.innerHTML = '&#9658;';
            b.appendChild(p);
        }
        b.addEventListener('click', function () { show(i); });
        thumbs.appendChild(b);
    });

    function show(i) {
        current = (i + items.length) % items.length;
        var it = items[current];
        media.innerHTML = '';   // це ж зупиняє попереднє відео

        var el;
        if (it.type === 'img') {
            el = document.createElement('img');
            el.src = it.src;
        } else if (it.type === 'youtube') {
            el = document.createElement('iframe');
            el.src = it.src;
            el.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            el.allowFullscreen = true;
        } else {
            el = document.createElement('video');
            el.src = it.src;
            el.controls = true;
            el.playsInline = true;
        }
        media.appendChild(el);

        thumbs.querySelectorAll('.lb-thumb').forEach(function (t, idx) {
            t.classList.toggle('active', idx === current);
        });
    }

    function open(i) {
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
        show(i);
    }

    function close() {
        lb.hidden = true;
        media.innerHTML = '';
        document.body.style.overflow = '';
    }

    // клік по фото в галереї
    document.querySelectorAll('.gallery-zoom').forEach(function (img) {
        img.addEventListener('click', function () {
            open(parseInt(img.dataset.index, 10) || 0);
        });
    });

    lb.querySelector('.lb-prev').addEventListener('click', function () { show(current - 1); });
    lb.querySelector('.lb-next').addEventListener('click', function () { show(current + 1); });
    lb.querySelector('.lb-close').addEventListener('click', close);

    // клік по затемненому фону
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });

    // клавіатура
    document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
    });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var gallery = document.getElementById('productGallery');
    if (!gallery) return;

    gallery.addEventListener('slid.bs.carousel', function () {
        // YouTube: підвантажити на своєму слайді, прибрати на інших
        gallery.querySelectorAll('iframe').forEach(function (f) {
            var active = f.closest('.carousel-item').classList.contains('active');
            if (active && !f.getAttribute('src')) {
                f.setAttribute('src', f.dataset.src);
            } else if (!active && f.getAttribute('src')) {
                f.removeAttribute('src');
            }
        });

        // Відеофайл: поставити на паузу, коли слайд неактивний
        gallery.querySelectorAll('video').forEach(function (v) {
            if (!v.closest('.carousel-item').classList.contains('active')) v.pause();
        });
    });
});
</script>