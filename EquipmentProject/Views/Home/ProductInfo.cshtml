
@model EquipmentProject.Models.Product

@{
    ViewData["Title"] = Model.ProductName;
}

<div class="product-view-page">

    <!-- =========================
         BREADCRUMBS
    ========================= -->

    <div class="product-view-breadcrumbs">

        <a asp-controller="Home"
           asp-action="Index">
            ⌂ Головна
        </a>

        <span>›</span>

        <a asp-controller="Product"
           asp-action="Index">
            Каталог
        </a>

        <span>›</span>

        <a asp-controller="Product"
           asp-action="Category"
           asp-route-id="@Model.CategoryId">
            Категорія
        </a>

        @if (Model.Subcategory != null)
        {
            <span>›</span>
            /*
            <span>
                @Model.Subcategory.ProductName
            </span>*/
        }

        <span>›</span>

        <strong>
            @Model.ProductName
        </strong>

    </div>


    <!-- =========================
         PRODUCT
    ========================= -->

    <div class="product-view-content">

        <!-- ФОТО -->

        <div class="product-view-image">

            @if (!string.IsNullOrWhiteSpace(Model.ImgPath))
            {
                <img src="@Model.ImgPath"
                     alt="@Model.ProductName">
            }
            else
            {
                <div class="product-view-no-photo">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="42"
                         height="42"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5">

                        <rect x="3"
                              y="3"
                              width="18"
                              height="18"
                              rx="2">
                        </rect>

                        <circle cx="8.5"
                                cy="8.5"
                                r="1.5">
                        </circle>

                        <path d="M21 15l-5-5L5 21">
                        </path>

                    </svg>

                    <span>Фото відсутнє</span>

                </div>
            }

        </div>


        <!-- ІНФОРМАЦІЯ -->

        <div class="product-view-info">

            <!-- Артикул -->

            <div class="product-view-articul">

                <span>Артикул:</span>

                @Model.Articul

            </div>


            <!-- Назва -->

            <h1 class="product-view-title">
                @Model.ProductName
            </h1>


            <div class="product-view-separator"></div>


            <!-- Ціна -->

            <div class="product-view-price">
                @Model.Price.ToString("N0") ₴
            </div>

            <div class="product-view-price-note">
                Ціна вказана за умови самовивозу зі складу
            </div>


            <div class="product-view-separator"></div>


            <!-- КНОПКИ -->

            <div class="product-view-buttons">

                <a href="/contacts"
                   class="product-view-button product-view-button-main">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="17"
                         height="17"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                 19.79 19.79 0 0 1-8.63-3.07
                                 19.5 19.5 0 0 1-6-6
                                 19.79 19.79 0 0 1-3.07-8.67
                                 A2 2 0 0 1 4.11 2h3
                                 a2 2 0 0 1 2 1.72
                                 12.84 12.84 0 0 1 .7 2.81
                                 2 2 0 0 1-.45 2.11L8.09 9.91
                                 a16 16 0 0 0 6 6l1.27-1.27
                                 a2 2 0 0 1 2.11-.45
                                 12.84 12.84 0 0 0 2.81.7
                                 A2 2 0 0 1 22 16.92z">
                        </path>

                    </svg>

                    Замовити консультацію

                </a>


                <a href="/contacts"
                   class="product-view-button product-view-button-outline">

                    Залишити запит

                </a>

            </div>

        </div>

    </div>


    <!-- =========================
         DESCRIPTION
    ========================= -->





@if (!string.IsNullOrWhiteSpace(Model.FullDescription) || Model.TechnicalCharacteristics.Any())
{
    <div class="product-view-details">

        <!-- Детальний опис -->
        <div class="product-view-full-description">

            <div class="product-view-section-title">
                Детальний опис
            </div>

            <div class="product-view-description-content">
                @Html.Raw(Model.FullDescription)
            </div>

        </div>

        <!-- Технічні характеристики -->
        <div class="product-view-specifications">

            <div class="product-view-section-title">
                Технічні характеристики
            </div>

            <table class="product-view-spec-table">

                <tbody>

                @foreach (var item in Model.TechnicalCharacteristics)
                {
                    <tr>
                        <td class="product-view-spec-name">
                            @item.ParamentName
                        </td>

                        <td class="product-view-spec-value">
                            @item.ParamentValue
                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>
}
