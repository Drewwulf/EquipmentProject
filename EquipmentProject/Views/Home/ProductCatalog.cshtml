@model EquipmentProject.Models.ViewModels.ProductViewModel

<section class="new-products-section detailsColor">

    <div class="new-products-container">

        <div class="section-heading">
            <div class="section-line"></div>
            <h2>@Model.SubCategoryName</h2>
        </div>

        <div class="products-grid">

            @foreach (var pcatalog in Model.products)
            {
                <div class="product-card">

                    <div class="product-image-box">

                        <img src="@pcatalog.ImgPath"
                             alt="@pcatalog.ProductName" />

                    </div>

                    <div class="product-content">

                        <span class="product-article">
                            Арт.@pcatalog.Articul
                        </span>

                        <h3 class="product-title">
                            @pcatalog.ProductName
                        </h3>

                        <p class="product-description">
                            @pcatalog.ShortDescription
                        </p>

                        <div class="product-bottom">

                            <span class="product-price">
                                @pcatalog.Price
                            </span>

                            <a asp-controller="Home"
                               asp-action="ProductInfo"
                               asp-route-id="@pcatalog.Id"
                               class="product-details">
                                Детальніше
                                <span>→</span>
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>



        
