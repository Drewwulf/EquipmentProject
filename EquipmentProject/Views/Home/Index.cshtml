
@{
    ViewData["Title"] = "Home Page";
}
@model EquipmentProject.Models.ViewModels.SiteSettingViewModel

<section class="hero-section">

    <div class="hero-grid">

        <!-- Ліва частина -->
        <div class="hero-content">
            <div class="hero-text">

                <div class="hero-line"></div>

                <h1>
                    @Model.HeaderInfo
                </h1>

                @{
                    if (Model.SubHeaderInfo == null)
                    {
                        <p>

                        </p>
                    }
                    else
                    {
                        <p>
                            @Model.SubHeaderInfo
                        </p>
                    }
                }

                <div class="hero-buttons">

                    <a href="/catalog" class="hero-btn hero-btn-primary">
                        Переглянути каталог

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </a>

                    <a href="/contacts" class="hero-btn hero-btn-outline">
                        Зв'язатися з нами
                    </a>

                </div>

            </div>
        </div>

        <!-- Права частина -->
        <div class="hero-image">
            <img src="https://media.base44.com/images/public/6a514bf0d884202ac5c64fbb/fb3ce28b1_generated_fcf57e95.png"
                 alt="Промислове обладнання">
        </div>

    </div>
</section>

<section class="category-bar">

    <div class="category-container">

        @foreach (var category in ViewBag.Categories)
        {
            <a asp-controller="Product" 
                   asp-action="Category"
                   asp-route-id="@category.Id">

                <span></span>

                @category.ProductName

            </a>
        }

    </div>

</section>
<section class="new-products-section">
    
    <div class="new-products-container">

        <div class="section-heading">
            <div class="section-line"></div>
            <h2>Нові товари</h2>
        </div>

        <div class="products-grid">

            <!-- Товар 1 -->
            @foreach (var product in Model.Products)
            {
                
            
            <div class="product-card">

                <div class="product-image-box">
                    <span class="product-badge">НОВИНКА</span>

                    <div class="no-image">
                        Фото відсутнє
                    </div>
                </div>

                <div class="product-content">
                    <span class="product-article">Арт.@product.Articul</span>

                    <h3 class="product-title">
                            @product.ProductName
                    </h3>

                    <p class="product-description">
                            @product.ShortDescription
                    </p>

                    <div class="product-bottom">
                        <span class="product-price">
                                @product.Price
                        </span>

                        <a asp-controller="Home" 
                   asp-action="ProductInfo"
                   asp-route-id="@product.Id" class="product-details">
                                Детальніше
                            <span>→</span>
                        </a>
                    </div>
                </div>

            </div>
            }
</section>
