
@{
    ViewData["Title"] = "Home Page";
}
@model EquipmentProject.Models.ViewModels.SiteSettingViewModel

<section class="hero-section">

    <div class="hero-grid">

        <!-- Ліва частина -->
        <div class="hero-content">
            <div class="hero-text">

                <div class="hero-line"></div>

                <h1>
                    @Model.HeaderInfo
                </h1>

                @{
                    if (Model.SubHeaderInfo == null)
                    {
                        <p>

                        </p>
                    }
                    else
                    {
                        <p>
                            @Model.SubHeaderInfo
                        </p>
                    }
                }

                <div class="hero-buttons">

                    <a href="/catalog" class="hero-btn hero-btn-primary">
                        Переглянути каталог

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </a>

                    <a href="/contacts" class="hero-btn hero-btn-outline">
                        Зв'язатися з нами
                    </a>

                </div>

            </div>
        </div>

        <!-- Права частина -->
        <div class="hero-image">
            <img src="https://media.base44.com/images/public/6a514bf0d884202ac5c64fbb/fb3ce28b1_generated_fcf57e95.png"
                 alt="Промислове обладнання">
        </div>

    </div>
</section>

<section class="category-bar">

    <div class="category-container">

        @foreach (var category in ViewBag.Categories)
        {
            <a asp-controller="Product" 
                   asp-action="Category"
                   asp-route-id="@category.Id">

                <span></span>

                @category.ProductName

            </a>
        }
  

    </div>
    
</section>
<section class="popular-categories">

    <div class="categories-header">

        <div>
            <span class="categories-line"></span>

            <h2>Популярні категорії</h2>
        </div>

        <a href="/catalog" class="all-categories">
            Усі категорії
            <span>→</span>
        </a>

    </div>


    <div class="categories-grid">
        @foreach (var famous in Model.Categories)
        {
            <a href="/catalog" style="
                background-image:
                linear-gradient(
                to bottom,
                rgba(255, 249, 225, 0.18) 0%,
                rgba(255, 246, 210, 0.28) 35%,
                rgba(220, 200, 150, 0.45) 68%,
                rgba(210, 190, 130, 0.70) 100%
                ),
                url(' @famous.ImgPath');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;" class="category-card category-image category-gradient">

                <div class="category-content">

                    <h3>@famous.ProductName</h3>

                    <p>Переглянути</p>

                    <span class="category-arrow">→</span>

                </div>

            </a>
        }
        <!-- Картка 1 -->
      </div>

</section>
<section class="new-products-section">
    
    <div class="new-products-container">

        <div class="section-heading">
            <div class="section-line"></div>
            <h2>Нові товари</h2>
        </div>

        <div class="products-grid">

            <!-- Товар 1 -->
            @foreach (var product in Model.Products)
            {
                if (product.IsNew == true)
                {



                    <div class="product-card">

                        <div class="product-image-box">
                            <span class="product-badge">НОВИНКА</span>

                            <div class="no-image">
                                Фото відсутнє
                            </div>
                        </div>

                        <div class="product-content">
                            <span class="product-article">Арт.@product.Articul</span>

                            <h3 class="product-title">
                                @product.ProductName
                            </h3>

                            <p class="product-description">
                                @product.ShortDescription
                            </p>

                            <div class="product-bottom">
                                <span class="product-price">
                                    @product.Price
                                </span>

                                <a asp-controller="Home" 
                                asp-action="ProductInfo"
                                asp-route-id="@product.Id" class="product-details">
                                    Детальніше
                                    <span>→</span>
                                </a>
                            </div>
                        </div>

                    </div>
                }
            }
          
</section>



       <section class="new-products-section recommended-bg">
    
    <div class="new-products-container">

        <div class="section-heading">
            <div class="section-line"></div>
            <h2>Рекомендовані товари</h2>
        </div>

        <div class="products-grid">

            @foreach (var product in Model.Products)
            {
                if (product.IsRecomended == true)
                {



                    <div class="product-card">

                    <div class="product-image-box">
                        <div class="no-image">
                            Фото відсутнє
                        </div>
                    </div>

                    <div class="product-content">
                        <span class="product-article">Арт.@product.Articul</span>

                        <h3 class="product-title">
                            @product.ProductName
                        </h3>

                        <p class="product-description">
                            @product.ShortDescription
                        </p>

                        <div class="product-bottom">
                            <span class="product-price">
                                @product.Price
                            </span>

                            <a asp-controller="Home" 
                               asp-action="ProductInfo"
                               asp-route-id="@product.Id" class="product-details">
                                Детальніше
                                <span>→</span>
                            </a>
                        </div>
                    </div>

                </div>
                }
            }

        </div>

    </div>

</section>


        <section class="why-us-section">

            <div class="why-us-container">

                <div class="why-us-header">
                    <span class="why-us-line"></span>
                    <h2>Чому обирають нас</h2>
                </div>

                <div class="why-us-grid">

                    @foreach (var ww in Model.WhyWes){
                        <div class="why-us-item">
                        <div class="why-us-icon">
                            <img src=@ww.ImgPath />
                        </div>

                        <h3>@ww.header</h3>

                        <p>
                           @ww.subheader
                        </p>
                    </div>
                    }

                   

                </div>

            </div>

        </section>
