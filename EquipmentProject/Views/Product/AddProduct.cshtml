@model EquipmentProject.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = Model.View == "Edit" ? "Редагувати товар" : "Створити товар";
    bool IsEdit = Model.View == "Edit";
    string mainImageRequired = IsEdit ? null : "required";
}

<form asp-controller="Product" asp-action="@(IsEdit ? "Edit" : "StartProduct")" method="post" enctype="multipart/form-data">
    @if (IsEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImgPath" />
    }

    <div class="product-edit-page">

        <!-- Заголовок -->
        <h2 class="product-edit-title">@(IsEdit ? "Редагувати товар" : "Створити товар")</h2>


        <!-- =========================
             ОСНОВНА ІНФОРМАЦІЯ
        ========================== -->
        <section class="product-section">
            <h3>Основна інформація</h3>

            <!-- Назва -->
            <div class="product-field">
                <label for="productName">
                    Назва *
                </label>

                <input asp-for="ProductName"
                       type="text"
                       id="productName"
                       required />
            </div>


            <!-- Артикул + Ціна -->
            <div class="product-grid">

                <div class="product-field">

                    <label for="article">
                        Артикул *
                    </label>

                    <input asp-for="Articul"
                           type="text"
                           id="article"
                           required />

                </div>


                <div class="product-field">

                    <label for="price">
                        Ціна (₴) *
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           id="price"
                           required />

                </div>

            </div>


            <!-- Категорія + Підкатегорія -->
            <div class="product-grid">

                <div class="product-field">

                    <label for="category">
                        Категорія *
                    </label>

                    <select id="category"
                            asp-for="CategoryId"
                            required>
                        <option value="">Оберіть категорію</option>
                        @if (Model.Categories != null)
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.ProductName</option>
                            }
                        }
                    </select>

                </div>


                <div class="product-field">

                    <label for="subcategory">
                        Підкатегорія *
                    </label>

                    <select id="subcategory"
                            asp-for="SubcategoryId"
                            required>

                        <option value="">Спочатку оберіть категорію</option>

                    </select>

                </div>

            </div>


            <!-- Короткий опис -->
            <div class="product-field">

                <label for="shortDescription">
                    Короткий опис *
                </label>

                <textarea asp-for="ShortDescription"
                          id="shortDescription"
                          placeholder="Короткий опис для картки товару"
                          required></textarea>

            </div>


            <!-- Повний опис -->
            <div class="product-field">

                <label for="description">
                    Повний опис
                </label>

                <textarea asp-for="FullDescription"
                          id="description"
                          class="full-description"
                          placeholder="Детальний опис товару"></textarea>

            </div>


            <!-- Checkbox -->
            <div class="product-checkboxes">

                <label class="checkbox-item">

                    <input asp-for="IsNew"
                           type="checkbox" />

                    <span>Новинка</span>

                </label>


                <label class="checkbox-item">

                    <input asp-for="IsRecomended"
                           type="checkbox" />

                    <span>Рекомендований</span>

                </label>

            </div>

        </section>

        <!-- =========================
             ЗОБРАЖЕННЯ
        ========================== -->

        <section class="product-section">

            <h3>Зображення</h3>


            <!-- Основне фото -->
            <div class="product-field">
                <label>Зображення</label>
                @if (IsEdit && !string.IsNullOrEmpty(Model.ImgPath))
                {
                    <div class="current-image">
                        <img src="@Model.ImgPath"
                             alt="@Model.ProductName"
                             width="200" />
                    </div>
                }


                <label for="mainImage" class="outline-button">
                    <span>↥</span> Завантажити
                </label>

                <input type="file"
                       id="mainImage"
                       asp-for="MainImage"
                       accept="image/*"
                       hidden
                       required="@mainImageRequired" />
            </div>


            <!-- Галерея -->
            <div class="image-block">

                <label>
                    Галерея фотографій
                </label>

                <label for="galleryImages"
                       class="outline-button">

                    <span>▧</span>
                    Додати фото

                </label>

                <input type="file"
                       asp-for ="GalleryImages"
                       id="galleryImages"
                       name="GalleryImages"
                       accept="image/*"
                       multiple
                       hidden />


                    @if (IsEdit)
                    {
                     <div class="images-container">
                        <label class="images-title">Гарелея фото</label>
                   
                        <div class="images-gallery">
                            @foreach (var image in Model.Images)
                            {
                                <div class="image-card">
                                    <a asp-controller="Product" asp-action="DeleteImage" method="post" asp-route-id="@image.Id" type="button" class="image-delete-btn">×</a>

                                    <img src="@image.ImgPath" alt="Зображення банера">
                                </div>
                            }
                        </div>
                </div>   
                    }

            </div>

        </section>



        <!-- =========================
             ТЕХНІЧНІ ХАРАКТЕРИСТИКИ
        ========================== -->

        <section class="product-section specifications-section">

            <div class="section-header">

                <h3>
                    Технічні характеристики
                </h3>

                <button type="button"
                        class="add-button"
                        id="addSpecification">

                    + Додати

                </button>

            </div>


            <div id="specificationsContainer">

                <p class="empty-specifications">
                    Характеристик поки немає. Додайте першу.
                </p>

            </div>

        </section>



        <!-- =========================
             КНОПКИ
        ========================== -->

        <div class="product-actions">

            <button type="submit"
                    class="save-button">

                <span>▣</span>
                Зберегти товар

            </button>

            @if (IsEdit)
            {
                <a class="save-button" asp-controller="Product" asp-action="AddProduct">
                    Скасувати
                </a>
            }

        </div>

    </div>
</form>


<div class="product-edit-page">

    <div class="subcategories-header">
        <div>
            <h1>Товари</h1>
            <p>Керування товарами</p>
        </div>
    </div>

    @if (Model.Products != null)
    {
        @foreach (var product in Model.Products.Take(10))
        {

            <div class="subcategory-container">

                <div class="subcategory-container-image">
                    @if (!string.IsNullOrEmpty(product.ImgPath))
                    {
                        <img src="@product.ImgPath" alt="@product.ProductName" />
                    }
                    else
                    {
                        <span class="no-image">Немає фото</span>
                    }
                </div>

                <div class="subcategory-container-info">
                    <h3>@product.ProductName</h3>
                    <p>@product.ShortDescription</p>
                </div>

                <div class="subcategory-container-buttons">

                    <form asp-controller="Product"
                          asp-action="Delete"
                          asp-route-id="@product.Id"
                          method="post"
                          onsubmit="return confirm('Ви впевнені, що хочете видалити цей товар?');">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="subcategory-icon-btn delete-btn">
                            <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4.91666667,14.8888889 C4.91666667,15.3571429 5.60416667,16 6.0625,16 L12.9375,16 C13.3958333,16 14.0833333,15.3571429 14.0833333,14.8888889 L14.0833333,6 L4.91666667,6 L4.91666667,14.8888889 Z M15,3.46500003 L12.5555556,3.46500003 L11.3333333,2 L7.66666667,2 L6.44444444,3.46500003 L4,3.46500003 L4,4.93000007 L15,4.93000007 Z"
                                      fill="currentColor" />
                            </svg>
                        </button>

                    </form>

                    <a asp-controller="Product"
                       asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="subcategory-icon-btn">

                        <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.25,12.9378906 L2.25,15.75 L5.06210943,15.75 L13.3559575,7.45615192 L10.5438481,4.64404249 L2.25,12.9378906 Z M15.5306555,5.28145396 C15.8231148,4.98899458 15.8231148,4.5165602 15.8231148,4.5165602 L13.7758992,2.46934454 C13.4834398,2.17688515 13.0110052,2.17688515 12.718546,2.46934454 L11.3462366,3.84165394 L14.1583461,6.65376337 L15.5306555,5.28145396 Z"
                                  fill="currentColor" />
                        </svg>

                    </a>

                </div>

            </div>

        }

        @if (Model.Products.Count() == 10)
        {
            <div class="show-all-products"> <a asp-controller="Product" asp-action="Index" class="save-button"> Показати всі товари </a> </div>
        }
    }

</div>

<script>
    let siteind = 0;
    const addSpecificationButton = document.getElementById("addSpecification");
    const specificationsContainer = document.getElementById("specificationsContainer");

        const existingCharacteristics = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.TechnicalCharacteristics?.Select(tc => new
                {
                        tc.ParamentName,
                        tc.ParamentValue
                }) ?? Enumerable.Empty<object>()
        ));

    function addSpecificationRow(name = '', value = '') {
        const emptyMessage = specificationsContainer.querySelector(".empty-specifications");
        if (emptyMessage) {
            emptyMessage.remove();
        }

        const specification = document.createElement("div");
        specification.className = "specification-row";

        specification.innerHTML = `
            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParamentName"
                   value="${name}"
                   placeholder="Назва характеристики">

            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParamentValue"
                   value="${value}"
                   placeholder="Значення">

            <button type="button" class="delete-specification">×</button>
        `;

        specification.querySelector(".delete-specification").addEventListener("click", function() {
            specification.remove();
            if (specificationsContainer.children.length === 0) {
                specificationsContainer.innerHTML = '<p class="empty-specifications">Характеристик поки немає. Додайте першу.</p>';
            }
        });

        specificationsContainer.appendChild(specification);
        siteind++;
    }

    if (existingCharacteristics && existingCharacteristics.length > 0) {
        existingCharacteristics.forEach(tc => {
            addSpecificationRow(tc.ParamentName || tc.ParameterName || '', tc.ParamentValue || tc.ParameterValue || '');
        });
    }

    addSpecificationButton.addEventListener("click", function () {
        addSpecificationRow();
    });

    async function loadSubcategories(categoryId, selectedSubcategoryId = null) {
        const subcategorySelect = document.getElementById('subcategory');
        subcategorySelect.innerHTML = '<option value="">Оберіть підкатегорію</option>';

        if (!categoryId) {
            return;
        }

        try {
            const response = await fetch(`/Category/GetSubcategories?categoryId=${categoryId}`);

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`HTTP ${response.status}: ${errorText}`);
            }

            const subcategories = await response.json();

            let optionsHtml = '<option value="">Оберіть підкатегорію</option>';
            subcategories.forEach(sub => {
                const isSelected = (selectedSubcategoryId && sub.id == selectedSubcategoryId) ? 'selected' : '';
                optionsHtml += `<option value="${sub.id}" ${isSelected}>${sub.nameSubcategory}</option>`;
            });
            subcategorySelect.innerHTML = optionsHtml;

        } catch (error) {
            console.error("Помилка:", error);
        }
    }

    document.getElementById('category').addEventListener('change', function() {
        loadSubcategories(this.value);
    });

    document.addEventListener('DOMContentLoaded', function () {
        const categorySelect = document.getElementById('category');
        const initialSubcategoryId = '@Model.SubcategoryId';

        if (categorySelect.value) {
            loadSubcategories(categorySelect.value, initialSubcategoryId);
        }
    });
</script>