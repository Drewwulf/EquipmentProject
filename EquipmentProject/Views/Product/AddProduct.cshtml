@model EquipmentProject.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Редагувати товар";
}
<form asp-controller="Product" asp-action="StartProduct">

<div class="product-edit-page">

    <!-- Заголовок -->
    <h2 class="product-edit-title">Редагувати товар</h2>


    <!-- =========================
         ОСНОВНА ІНФОРМАЦІЯ
    ========================== -->

    <section class="product-section">
        <h3>Основна інформація</h3>

        <!-- Назва -->
        <div class="product-field">
            <label for="productName">
                Назва *
            </label>

                <input asp-for="ProductName" type="text"
                   id="productName"
                
                    />
        </div>


        <!-- Артикул + Ціна -->
        <div class="product-grid">

            <div class="product-field">

                <label for="article">
                    Артикул
                </label>

                <input asp-for="Articul" type="text"
                       id="article"
                    
                       />

            </div>


            <div class="product-field">

                <label for="price">
                    Ціна (₴) *
                </label>

                <input asp-for="Price" type="number"
                       id="price"
                    
                       />

            </div>

        </div>


        <!-- Категорія + Підкатегорія -->
        <div class="product-grid">

            <div class="product-field">

                <label for="category">
                    Категорія
                </label>

                <select id="category"
                        name="CategoryId">

                    <option >Оберіть категорію</option>

                    <option  selected>
                        Харчове обладнання
                    </option>

                    <option >
                        Холодильне обладнання
                    </option>

                    <option>
                        Пральне обладнання
                    </option>

                    <option >
                        Виробниче обладнання
                    </option>

                </select>

            </div>


            <div class="product-field">

                <label for="subcategory">
                    Підкатегорія
                </label>

                <select id="subcategory"
                        name="SubcategoryId">

                    <option>
                        Оберіть підкатегорію
                    </option>

                    <option  selected>
                        Шафи та столи
                    </option>

                    <option >
                        Стелажі
                    </option>

                    <option>
                        Мийки
                    </option>

                    <option >
                        Візки
                    </option>

                </select>

            </div>

        </div>


        <!-- Короткий опис -->
        <div class="product-field">

            <label for="shortDescription">
                Короткий опис
            </label>

            <textarea asp-for="ShortDescription" id="shortDescription"
                  
                      placeholder="Короткий опис для картки товару"></textarea>

        </div>


        <!-- Повний опис -->
        <div class="product-field">

            <label for="description">
                Повний опис
            </label>

            <textarea asp-for="FullDescription" id="description"
                    
                      class="full-description"
                      placeholder="Детальний опис товару"></textarea>

        </div>


        <!-- Checkbox -->
        <div class="product-checkboxes">

            <label class="checkbox-item">

                <input asp-for="IsNew" type="checkbox"
                       
                       checked />

                <span>Новинка</span>

            </label>


            <label class="checkbox-item">

                <input asp-for="IsRecomended" type="checkbox"
 />

                <span>Рекомендований</span>

            </label>

        </div>

    </section>



    <!-- =========================
         ЗОБРАЖЕННЯ
    ========================== -->

    <section class="product-section">

        <h3>Зображення</h3>


        <!-- Основне фото -->
        <div class="image-block">

            <label>
                Основне фото
            </label>

            <label for="mainImage"
                   class="outline-button">

                <span>↥</span>
                Завантажити

            </label>

            <input type="file"
                   id="mainImage"
                   name="MainImage"
                   accept="image/*"
                   hidden />

        </div>


        <!-- Галерея -->
        <div class="image-block">

            <label>
                Галерея фотографій
            </label>

            <label for="galleryImages"
                   class="outline-button">

                <span>▧</span>
                Додати фото

            </label>

            <input type="file"
                   id="galleryImages"
                   name="GalleryImages"
                   accept="image/*"
                   multiple
                   hidden />

        </div>

    </section>



    <!-- =========================
         ТЕХНІЧНІ ХАРАКТЕРИСТИКИ
    ========================== -->

    <section class="product-section specifications-section">

        <div class="section-header">

            <h3>
                Технічні характеристики
            </h3>

            <button type="button"
                    class="add-button"
                    id="addSpecification">

                + Додати

            </button>

        </div>


        <div id="specificationsContainer">

            <p class="empty-specifications">
                Характеристик поки немає. Додайте першу.
            </p>

        </div>

    </section>



    <!-- =========================
         КНОПКИ
    ========================== -->

    <div class="product-actions">

        <button  type="submit" method="posts"
                class="save-button">

            <span>▣</span>
            Зберегти товар

        </button>


        <button type="button"
                class="cancel-button">

            Скасувати

        </button>

    </div>

</div>
</form>

<script>
    const tcs = @Html.Raw(Json.Serialize(Model.TechnicalCharacteristics))

    let siteind = tcs.length;

    const addSpecificationButton =
        document.getElementById("addSpecification");

    const specificationsContainer =
        document.getElementById("specificationsContainer");

     for (let i = 0; i < tcs.length; i++) {
        const tc = tcs[i];
        
        specification.className =
            "specification-row";


        specification.innerHTML = `

            <input type="text"
                   class="specification-input"
                   value = "${tc.ParameterName ?? ''}"
                   placeholder="Назва характеристики">


            <input type="text"
                   class="specification-input"
                   value = "${tc.ParameterValue ?? ''}"
                   placeholder="Значення">


            <button type="button"
                    class="delete-specification">
                ×
            </button>

        `;


        specificationsContainer.appendChild(specification);

     }

    addSpecificationButton.addEventListener("click", function () {

        const emptyMessage =
            specificationsContainer.querySelector(".empty-specifications");

        if (emptyMessage) {
            emptyMessage.remove();
        }


        const specification =
            document.createElement("div");

        specification.className =
            "specification-row";


        specification.innerHTML = `

            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParameterName"
                   placeholder="Назва характеристики">


            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParameterValue"
                   placeholder="Значення">


            <button type="button"
                    class="delete-specification">
                ×
            </button>

        `;


        specificationsContainer.appendChild(specification);

        siteind++;

    });

</script>

