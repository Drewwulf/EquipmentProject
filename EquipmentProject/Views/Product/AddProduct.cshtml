@model EquipmentProject.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Редагувати товар";
}
<form asp-controller="Product" asp-action="StartProduct">

<div class="product-edit-page">

    <!-- Заголовок -->
    <h2 class="product-edit-title">Редагувати товар</h2>


    <!-- =========================
         ОСНОВНА ІНФОРМАЦІЯ
    ========================== -->
        <section class="product-section">
            <h3>Основна інформація</h3>

            <!-- Назва -->
            <div class="product-field">
                <label for="productName">
                    Назва *
                </label>

                <input asp-for="ProductName"
                       type="text"
                       id="productName"
                       required />
            </div>


            <!-- Артикул + Ціна -->
            <div class="product-grid">

                <div class="product-field">

                    <label for="article">
                        Артикул *
                    </label>

                    <input asp-for="Articul"
                           type="text"
                           id="article"
                           required />

                </div>


                <div class="product-field">

                    <label for="price">
                        Ціна (₴) *
                    </label>

                    <input asp-for="Price"
                           type="number"
                           id="price"
                           required />

                </div>

            </div>


            <!-- Категорія + Підкатегорія -->
            <div class="product-grid">

                <div class="product-field">

                    <label for="category">
                        Категорія *
                    </label>

                    <select id="category"
                            name="CategoryId"
                            required>

                        <option value="">Оберіть категорію</option>

                        <option value="1" selected>
                            Харчове обладнання
                        </option>

                        <option value="2">
                            Холодильне обладнання
                        </option>

                        <option value="3">
                            Пральне обладнання
                        </option>

                        <option value="4">
                            Виробниче обладнання
                        </option>

                    </select>

                </div>


                <div class="product-field">

                    <label for="subcategory">
                        Підкатегорія *
                    </label>

                    <select id="subcategory"
                            name="SubcategoryId"
                            required>

                        <option value="">Оберіть підкатегорію</option>

                        <option value="1" selected>
                            Шафи та столи
                        </option>

                        <option value="2">
                            Стелажі
                        </option>

                        <option value="3">
                            Мийки
                        </option>

                        <option value="4">
                            Візки
                        </option>

                    </select>

                </div>

            </div>


            <!-- Короткий опис -->
            <div class="product-field">

                <label for="shortDescription">
                    Короткий опис *
                </label>

                <textarea asp-for="ShortDescription"
                          id="shortDescription"
                          placeholder="Короткий опис для картки товару"
                          required></textarea>

            </div>


            <!-- Повний опис -->
            <div class="product-field">

                <label for="description">
                    Повний опис
                </label>

                <textarea asp-for="FullDescription"
                          id="description"
                          class="full-description"
                          placeholder="Детальний опис товару"></textarea>

            </div>


            <!-- Checkbox -->
            <div class="product-checkboxes">

                <label class="checkbox-item">

                    <input asp-for="IsNew"
                           type="checkbox" />

                    <span>Новинка</span>

                </label>


                <label class="checkbox-item">

                    <input asp-for="IsRecomended"
                           type="checkbox" />

                    <span>Рекомендований</span>

                </label>

            </div>

        </section>

    <!-- =========================
         ЗОБРАЖЕННЯ
    ========================== -->

    <section class="product-section">

        <h3>Зображення</h3>


        <!-- Основне фото -->
        <div class="image-block">

            <label>
                Основне фото
            </label>

            <label for="mainImage"
                   class="outline-button">

                <span>↥</span>
                Завантажити

            </label>

            <input type="file"
                   id="mainImage"
                   name="MainImage"
                   accept="image/*"
                   hidden />

        </div>


        <!-- Галерея -->
        <div class="image-block">

            <label>
                Галерея фотографій
            </label>

            <label for="galleryImages"
                   class="outline-button">

                <span>▧</span>
                Додати фото

            </label>

            <input type="file"
                   id="galleryImages"
                   name="GalleryImages"
                   accept="image/*"
                   multiple
                   hidden />

        </div>

    </section>



    <!-- =========================
         ТЕХНІЧНІ ХАРАКТЕРИСТИКИ
    ========================== -->

    <section class="product-section specifications-section">

        <div class="section-header">

            <h3>
                Технічні характеристики
            </h3>

            <button type="button"
                    class="add-button"
                    id="addSpecification">

                + Додати

            </button>

        </div>


        <div id="specificationsContainer">

            <p class="empty-specifications">
                Характеристик поки немає. Додайте першу.
            </p>

        </div>

    </section>



    <!-- =========================
         КНОПКИ
    ========================== -->

    <div class="product-actions">

        <button  type="submit" method="posts"
                class="save-button">

            <span>▣</span>
            Зберегти товар

        </button>


        <button type="button"
                class="cancel-button">

            Скасувати

        </button>

    </div>

</div>
</form>

<script>
   
    let siteind = 0;
    const addSpecificationButton =
        document.getElementById("addSpecification");

    const specificationsContainer =
        document.getElementById("specificationsContainer");

     // for (let i = 0; i < tcs.length; i++) {
     //    const tc = tcs[i];
        
     //    specification.className =
     //        "specification-row";


     //    specification.innerHTML = `

     //        <input type="text"
     //               class="specification-input"
     //               value = "${tc.ParameterName ?? ''}"
     //               placeholder="Назва характеристики">


     //        <input type="text"
     //               class="specification-input"
     //               value = "${tc.ParameterValue ?? ''}"
     //               placeholder="Значення">


     //        <button type="button"
     //                class="delete-specification">
     //            ×
     //        </button>

     //    `;


     //    specificationsContainer.appendChild(specification);

     // }

    addSpecificationButton.addEventListener("click", function () {

        const emptyMessage =
            specificationsContainer.querySelector(".empty-specifications");

        if (emptyMessage) {
            emptyMessage.remove();
        }


        const specification =
            document.createElement("div");

        specification.className =
            "specification-row";


        specification.innerHTML = `

            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParamentName"
                   placeholder="Назва характеристики">


            <input type="text"
                   class="specification-input"
                   name="TechnicalCharacteristics[${siteind}].ParamentValue"
                   placeholder="Значення">


            <button type="button"
                    class="delete-specification">
                ×
            </button>

        `;


        specificationsContainer.appendChild(specification);

        siteind++;

    });

</script>

