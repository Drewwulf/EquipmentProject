```cshtml
@model List<EquipmentProject.Models.Product>

@{
    ViewData["Title"] = "Всі товари";
}

<div class="product-edit-page">

    <div class="subcategories-header">
        <div>
            <h1>Всі товари</h1>
            <p>Керування всіма товарами</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var product in Model)
        {
            <div class="subcategory-container">

                <div class="subcategory-container-image">
                    @if (!string.IsNullOrEmpty(product.ImgPath))
                    {
                        <img src="@product.ImgPath"
                             alt="@product.ProductName" />
                    }
                    else
                    {
                        <span class="no-image">Немає фото</span>
                    }
                </div>

                <div class="subcategory-container-info">
                    <h3>@product.ProductName</h3>
                    <p>@product.ShortDescription</p>
                </div>

                <div class="subcategory-container-buttons">

                    <a asp-controller="Product"
                       asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="subcategory-icon-btn"
                       title="Редагувати">
                        ✎
                    </a>

                    <form asp-controller="Product"
                          asp-action="Delete"
                          asp-route-id="@product.Id"
                          method="post"
                          onsubmit="return confirm('Ви впевнені, що хочете видалити цей товар?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="subcategory-icon-btn delete-btn"
                                title="Видалити">

                            <svg viewBox="0 0 18 18"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M4.91666667,14.8888889 C4.91666667,15.3571429 5.60416667,16 6.0625,16 L12.9375,16 C13.3958333,16 14.0833333,15.3571429 14.0833333,14.8888889 L14.0833333,6 L4.91666667,6 L4.91666667,14.8888889 Z M15,3.46500003 L12.5555556,3.46500003 L11.3333333,2 L7.66666667,2 L6.44444444,3.46500003 L4,3.46500003 L4,4.93000007 L15,4.93000007 Z"
                                      fill="currentColor" />
                            </svg>

                        </button>
                    </form>

                </div>
            </div>
        }
    }
    else
    {
        <p>Товарів поки немає.</p>
    }

</div>
```