<!DOCTYPE html>
<html lang="en">
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EquipmentProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EquipmentProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=settings" />
</head>
<body>
    <nav class="navbar">
        <div class="navbar-content">

            <div class="brand">
                <div class="brand-icon">
                    <img src="/lib/developer_board_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" />
                </div>
                <span>Наш магазин</span>
            </div>

            <div class="search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Пошук обладнання...">
            </div>

            <div class="links">
                <a href="#">Головна</a>
                <a href="#">Про компанію</a>

                <a href="#" class="catalog">
                    Каталог
                </a>

                <a href="#" class="contacts">
                    Контакти
                </a>
            </div>

        </div>
    </nav>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EquipmentProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
