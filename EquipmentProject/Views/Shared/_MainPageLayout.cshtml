<!DOCTYPE html>
<html lang="en">
@{
    var siteSettings = Context.SiteSettings.Include(site => site.Contacts)
        .OrderByDescending(s => s.Id)
        .First();

    var product = await Context.Products
        .Where(p => !p.IsDeleted)
        .Select(p => new { p.Id, p.ProductName, p.ShortDescription, p.ImgPath, p.Price, p.Articul })
        .ToListAsync();

    var category = await Context.Categories
        .Where(c => !c.IsDeleted)
        .Select(c => new { c.Id, c.ProductName, c.ShortDescription, c.ImgPath })
        .ToListAsync();
}



<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@siteSettings.ShopName - EquipmentProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MainPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EquipmentProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=settings" />
        @using System.Text.Json
@using System.Text.Json.Serialization
@using EquipmentProject.Data
@using Microsoft.EntityFrameworkCore
    @inject ApplicationDbContext Context

</head>
<body>
    <nav class="navbar">
        <div class="navbar-content">

            <div class="brand">
                <div class="brand-icon">
                    <img src="@siteSettings.ImgPathForLogo" />
                </div>
                <span>@siteSettings.ShopName</span>
            </div>

            <div class="search" id="div1" style="position:relative">
                <i class="bi bi-search"></i>
                <input id="searchBar" type="text" placeholder="Пошук обладнання..."> <!-- -->
                <div class = "searchDiv" id="searchedBox" ></div>
            </div>

            <div class="links">
                <a asp-controller="Home"
                   asp-action="Index">Головна</a>
                <a href="#">Про компанію</a>

                <a href="#new" class="catalog">
                    Каталог
                </a>

                <a href="#footer" class="contacts">
                    Контакти
                </a>
            </div>
        </div>
    </nav>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer" id="footer">
       
        <!-- Консультація -->
        <div class="footer-consultation">
            <div class="footer-consultation-content">
                <div>
                    <h2>Потрібна консультація?</h2>
                    <p>
                        Наші фахівці допоможуть підібрати обладнання під ваші виробничі задачі.
                    </p>
                </div>

                <div class="footer-consultation-buttons">
                    <a href="tel:@siteSettings.Contacts.First().PhoneNumber" class="footer-phone">
                        @siteSettings.Contacts.First().PhoneNumber
                    </a>

                    <a href="#" class="footer-contact-btn">
                        Контакти
                    </a>
                </div>
            </div>
        </div>

        
        <!-- Основна частина футера -->
        <div class="footer-main">

            <!-- Магазин -->
            <div class="footer-column footer-brand">

                <div class="brand">
                    <div class="brand-icon">
                       <img src="@siteSettings.ImgPathForLogo" />
                    </div>

                    <span>@siteSettings.ShopName</span>
                </div>

                <p>
                    @siteSettings.ShopDesc
                </p>

            </div>


            <!-- Навігація -->
            <div class="footer-column">

                <h3>НАВІГАЦІЯ</h3>

                <a asp-controller="Home"
                   asp-action="Index">>Головна</a>
                <a href="#new">Каталог</a>
                <a href="#">Про компанію</a>
                <a href="#">Контакти</a>

            </div>


            <!-- Контакти -->
            @{
                var addresses = new List<string>();
                var phones = new List<string>();
                var emails = new List<string>();
                var schedules = new List<string>();

                foreach (var contact in siteSettings.Contacts.Where(c => c.isdeleted != true))
                {
                    addresses.Add(contact.Address);
                    phones.Add(contact.PhoneNumber);
                    emails.Add(contact.Email);
                    schedules.Add(contact.Schedule);
                }

                var address = string.Join(", ", addresses);
                var phone = string.Join(", ", phones);
                var email = string.Join(", ", emails);
                var schedule = string.Join(", ", schedules);
            }



            <div class="footer-column">

                <h3>КОНТАКТИ</h3>

                <div class="footer-info">
                    <i class="bi bi-geo-alt"></i>
                    <span>@address</span>
                </div>

                <div class="footer-info">
                    <i class="bi bi-telephone"></i>
                    <span>@phone</span>
                </div>

                <div class="footer-info">
                    <i class="bi bi-envelope"></i>
                    <span>@email</span>
                </div>

                <div class="footer-info">
                    <i class="bi bi-clock"></i>
                    <span>@schedule</span>
                </div>

            </div>


            <!-- Соціальні мережі -->
            <div class="footer-column">

                <h3>СОЦІАЛЬНІ МЕРЕЖІ</h3>

                <div class="footer-socials">
                    <a href="@siteSettings.SocialFacebook" class="social-btn">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="@siteSettings.SocialInstagram" class="social-btn">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="@siteSettings.SocialTelegram" class="social-btn">
                        <i class="bi bi-telegram"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Нижня частина -->
        <div class="footer-bottom">
            <span>
                © 2026 Наш магазин. Усі права захищені.
            </span>
        </div>

        

    </footer>
    <script>
        const categories = @Html.Raw(JsonSerializer.Serialize(category));
        const products = @Html.Raw(JsonSerializer.Serialize(product));

        const productUrl = "@Url.Content("~/Home/ProductInfo")";
        const subcategoryUrl = "@Url.Content("~/Home/SubcategoryCatalog")";

        const searchedBox = document.getElementById("searchedBox");
        const searchBar = document.getElementById("searchBar");

        const height = document.getElementById("div1").offsetHeight;
        const width = document.getElementById("div1").offsetWidth;
        searchedBox.style.top = height + 5 + "px";
        searchedBox.style.width = width + "px";
        searchedBox.style.transform = "translate(-13px)";

        searchBar.addEventListener("input", function () {
            const searchV = this.value.trim().toLowerCase();

            searchedBox.innerHTML = "";

            if (!searchV) {
                searchedBox.style.display = "none";
                return;
            }

            const foundCategories = categories
                .filter(c =>
                    (c.ProductName ?? "").toLowerCase().includes(searchV) ||
                    (c.ShortDescription ?? "").toLowerCase().includes(searchV)
                )
                .map(c => ({ ...c, type: "category" }));

            const foundProducts = products
                .filter(p =>
                    (p.ProductName ?? "").toLowerCase().includes(searchV) ||
                    String(p.Articul ?? "").toLowerCase().includes(searchV)
                )
                .map(p => ({ ...p, type: "product" }));

            const found = [...foundCategories, ...foundProducts];

            searchedBox.style.display = "block";

            if (found.length === 0) {
                searchedBox.innerHTML = `
                    <div class="searchDivNotFounded">Нічого не знайдено</div>
                `;
                return;
            }

            found.forEach(item => {
                const link = document.createElement("a");

                link.href = item.type === "product"
                    ? `${productUrl}/${item.Id}`
                    : `${subcategoryUrl}/${item.Id}`;

                const img = item.ImgPath
                    ? `<img src="${item.ImgPath}" alt="" class="searchItemImg">`
                    : `<div class="searchItemImg searchItemNoImg"></div>`;

                const shortDesc = item.ShortDescription
                    ? `<div class="searchItemDesc">${item.ShortDescription}</div>`
                    : "";

                const articul = item.Articul !== undefined && item.Articul !== null
                    ? `<div class="searchItemArticul">Артикул: ${item.Articul}</div>`
                    : "";

                const price = item.Price !== undefined && item.Price !== null
                    ? `<div class="searchItemPrice">${item.Price} грн</div>`
                    : "";

                link.innerHTML = `
                    <div class="searchDivFounded">
                        ${img}
                        <div class="searchItemInfo">
                            <div class="searchItemName">${item.ProductName}</div>
                            ${shortDesc}
                            ${articul}
                        </div>
                        ${price}
                    </div>
                `;

                searchedBox.appendChild(link);
            });
        });
    </script>
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
