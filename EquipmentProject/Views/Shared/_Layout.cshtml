<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EquipmentProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EquipmentProject.styles.css" asp-append-version="true" />
    <!-- було -->
<link rel="stylesheet" href="~/https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined..." />
</head>
<body>
     <div class="mobile-topbar">
        <button type="button" class="burger-btn" id="burgerBtn" aria-label="Меню">
            <span></span><span></span><span></span>
        </button>
        <span class="mobile-topbar-title">Адмін-панель</span>
    </div>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <header>
        <aside class="admin-sidebar" id="adminSidebar"> <!-- Logo --> 
            <div class="sidebar-header">
                
                <div class="sidebar-logo"> 
                    <img src="/lib/developer_board_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" />
                </div>  <span>Адмін-панель</span>
            </div> <!-- Navigation --> 
            
            <nav class="sidebar-menu"> 
                <a asp-controller="Admin" asp-action="Index" class="sidebar-link"> 
                    <img src="/lib/dashboard_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Дашборд</span>
                </a> 
                <a asp-controller="Category" asp-action="Index" class="sidebar-link"> 
                    <img src="/lib/category_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Категорії</span>
                </a> 
                <a asp-controller="SubCategory" asp-action="Index" class="sidebar-link active"> 
                    <img src="/lib/arrow_split_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Підкатегорії</span>
                </a> 
                <a asp-controller="Product" asp-action="AddProduct" class="sidebar-link"> 
                    <img src="/lib/package_2_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Товари</span> 
                </a> 
                <a asp-controller="Admin" asp-action="SiteSettings" class="sidebar-link"> 
                    <img src="/lib/settings_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Налаштування сайту</span>
                </a> 
                <a asp-controller="Admin" asp-action="DeletedData" class="sidebar-link">
                    <img src="/lib/restore_from_trash_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" />
                    <span>Видалені дані</span>
                </a>
            </nav> <!-- Bottom --> 
            <form class="sidebar-link-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <div class="sidebar-bottom">
                
                    <button type="submit" class="sidebar-link btn btn-link text-dark"><img src="/lib/logout_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.png" class="img"/>Вийти</button>
            </div>
            </form>
        </aside>
    </header>
    <div>
        <main role="main" style="background-color: #FFF3C4">
   
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
    (function () {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const burger  = document.getElementById('burgerBtn');

        function toggle(open) {
            sidebar.classList.toggle('open', open);
            overlay.classList.toggle('show', open);
            document.body.classList.toggle('no-scroll', open);
        }

        burger.addEventListener('click', () => toggle(!sidebar.classList.contains('open')));
        overlay.addEventListener('click', () => toggle(false));

        // закривати меню після кліку по пункту
        sidebar.querySelectorAll('a').forEach(a =>
            a.addEventListener('click', () => toggle(false)));
    })();
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
