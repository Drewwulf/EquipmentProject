<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EquipmentProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EquipmentProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=settings" />
</head>
<body>
    <header>
        <aside class="admin-sidebar"> <!-- Logo --> 
            <div class="sidebar-header">
                
                <div class="sidebar-logo"> 
                    <img src="/lib/developer_board_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" />
                </div>  <span>Адмін-панель</span>
            </div> <!-- Navigation --> 
            
            <nav class="sidebar-menu"> 
                <a asp-controller="Admin" asp-action="Index" class="sidebar-link"> 
                    <img src="/lib/dashboard_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Дашборд</span>
                </a> 
                <a asp-controller="Category" asp-action="Category" class="sidebar-link"> 
                    <img src="/lib/category_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Категорії</span>
                </a> 
                <a asp-controller="SubCategory" asp-action="AddProduct" class="sidebar-link active"> 
                    <img src="/lib/arrow_split_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Підкатегорії</span>
                </a> 
                <a asp-controller="Product" asp-action="AddProduct" class="sidebar-link"> 
                    <img src="/lib/package_2_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Товари</span> 
                </a> 
                <a asp-controller="Admin" asp-action="SiteSettings" class="sidebar-link"> 
                    <img src="/lib/settings_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /> <span>Налаштування сайту</span>
                </a> 
            </nav> <!-- Bottom --> 
            <div class="sidebar-bottom"> 
                <a href="/" class="sidebar-link"> 
                    <img src="/lib/open_in_new_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png" /><span>Переглянути сайт</span>
                </a> 
            </div>
        </aside>
    </header>
    <div>
        <main role="main" style="background-color: #0c1423">
            class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EquipmentProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
