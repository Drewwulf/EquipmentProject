
@model EquipmentProject.Models.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Категорії";

    bool editMode = ViewBag.EditMode == true;
}

<div class="product-edit-page">

    <h2 class="product-edit-title">
        Керування категоріями
    </h2>

    <section class="product-section">

        @if (editMode)
        {
            <h3>Редагування категорії</h3>

            <form asp-controller="Category"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <!-- Назва -->
                <div class="product-field">
                    <label asp-for="ProductName">
                        Назва *
                    </label>

                    <input asp-for="ProductName"
                           id="categoryName"
                           placeholder="Наприклад: Харчове обладнання"
                           required />
                </div>

                <!-- Опис -->
                <div class="product-field">
                    <label asp-for="ShortDescription">
                        Опис
                    </label>

                    <textarea asp-for="ShortDescription"
                              id="categoryDescription"
                              placeholder="Короткий опис категорії"></textarea>
                </div>

                <!-- Порядок -->
                <div class="product-field">
                    <label asp-for="Order">
                        Порядок
                    </label>

                    <input asp-for="Order"
                           id="categoryOrder"
                           type="number" />
                </div>

                <!-- Поточне зображення -->
                <div class="product-field">
                    <label>Зображення</label>

                    @if (!string.IsNullOrEmpty(Model.ImgPath))
                    {
                        <div class="current-image">
                            <img src="@Model.ImgPath"
                                 alt="@Model.ProductName"
                                 width="200" />
                        </div>
                    }

                    <label for="mainImage" class="outline-button">
                        <span>↥</span> Завантажити нове
                    </label>

                    <input asp-for="MainImage"
                           id="mainImage"
                           type="file"
                           accept="image/*"
                           hidden />
                </div>

                <!-- Кнопки -->
                <div class="product-actions">

                    <button type="submit"
                            class="save-button">

                        <span>▣</span>
                        Зберегти категорію

                    </button>

                    <a asp-controller="Category"
                       asp-action="Category"
                       class="cancel-button">

                        Скасувати

                    </a>

                </div>

            </form>
        }
        else
        {
            <h3>Нова категорія</h3>

            <form asp-controller="Category"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <!-- Назва -->
                <div class="product-field">

                    <label asp-for="ProductName">
                        Назва *
                    </label>

                    <input asp-for="ProductName"
                           id="categoryName"
                           placeholder="Наприклад: Харчове обладнання"
                           required />

                </div>

                <!-- Опис -->
                <div class="product-field">

                    <label asp-for="ShortDescription">
                        Опис
                    </label>

                    <textarea asp-for="ShortDescription"
                              id="categoryDescription"
                              placeholder="Короткий опис категорії"></textarea>

                </div>

                <!-- Порядок -->
                <div class="product-field">

                    <label asp-for="Order">
                        Порядок
                    </label>

                    <input asp-for="Order"
                           id="categoryOrder"
                           type="number"
                           value="0" />

                </div>

                <!-- Зображення -->
                <div class="image-block">

                    <label asp-for="MainImage">
                        Зображення
                    </label>

                    <label for="categoryImage"
                           class="outline-button">

                        <span>↥</span>
                        Завантажити

                    </label>

                    <input asp-for="MainImage"
                           id="categoryImage"
                           type="file"
                           accept="image/*"
                           hidden />

                </div>

                <!-- Кнопки -->
                <div class="product-actions">

                    <button type="submit"
                            class="save-button">

                        <span>▣</span>
                        Зберегти категорію

                    </button>

                    <button type="reset"
                            class="cancel-button">

                        Скасувати

                    </button>

                </div>

            </form>
        }

    </section>

    <!-- СПИСОК КАТЕГОРІЙ -->

    <section class="product-section specifications-section">

        <div class="section-header">
            <h3>Категорії</h3>
        </div>

        <div id="categoriesContainer">

            @if (Model.Categories != null &&
                 Model.Categories.Any(x => !x.IsDeleted))
            {
                @foreach (var category in Model.Categories
                    .Where(x => !x.IsDeleted)
                    .OrderBy(x => x.Order))
                {
                    <div class="specification-row">

                        <!-- Назва -->
                        <h3 class="specification-input">
                            @category.ProductName
                        </h3>

                        <!-- Опис -->
                        <p class="specification-input">
                            @category.ShortDescription
                        </p>

                        <!-- Дії -->
                        <div class="category-list-actions">

                            <a asp-controller="Category"
                               asp-action="Edit"
                               asp-route-id="@category.Id"
                               class="edit-category-button"
                               title="Редагувати">
                                ✎
                            </a>

                            <form asp-controller="Category"
                                  asp-action="Delete"
                                  asp-route-id="@category.Id"
                                  method="post"
                                  onsubmit="return confirm('Ви впевнені, що хочете видалити цю категорію?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="delete-specification"
                                        title="Видалити">
                                    ×
                                </button>

                            </form>

                        </div>

                    </div>
                }
            }
            else
            {
                <p class="empty-specifications">
                    Категорій поки немає. Створіть першу категорію.
                </p>
            }

        </div>

    </section>

</div>
```
